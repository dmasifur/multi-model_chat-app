# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5432/chatapp
# Max connections per process (default 3). Each serverless instance opens its
# own pool; raise this only for long-running single-process deploys.
DATABASE_POOL_MAX=

# LLM providers (fill in your own; leave blank to disable a provider)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama (optional; leave blank to hide local models)
OLLAMA_BASE_URL=

# Auth.js (Phase 3)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign-in allowlist: at least one of these must be set, or every sign-in is
# denied. Comma-separated.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
