# Values loaded into the test process (see vitest.config.ts). None of these
# are real credentials - this file is committed on purpose so the test suite
# never runs with production-shaped secrets in scope, regardless of what's in
# the developer's local .env.
DATABASE_URL=postgresql://app:app@localhost:5432/chatapp_test

GROQ_API_KEY=test-groq-key
OPENROUTER_API_KEY=test-openrouter-key
OLLAMA_BASE_URL=http://localhost:11434

AUTH_SECRET=test-only-secret-do-not-use-in-production
AUTH_GITHUB_ID=test-github-id
AUTH_GITHUB_SECRET=test-github-secret
AUTH_GOOGLE_ID=test-google-id
AUTH_GOOGLE_SECRET=test-google-secret

# Left unset on purpose: lib/auth/__tests__/allowlist.test.ts exercises both
# the "neither is set" and "explicitly set" cases itself via vi.stubEnv.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
